# Optional server settings. Defaults work without this file.
# To load an .env file explicitly: node --env-file=.env server/index.js
HOST=127.0.0.1
PORT=3001
DB_PATH=data/stationflow.sqlite
# Provisional cafeteria demo hours, daily in America/Chicago.
# Omelets stay 08:00–11:00; hamburgers start at 11:00.
CAFETERIA_OPENS_AT=08:00
CAFETERIA_CLOSES_AT=20:00
# Optional, only for an approved HTTPS reverse proxy. Use an exact origin,
# without a trailing slash. Enables Secure cookies and strict origin checks.
# PUBLIC_ORIGIN=https://your-approved-demo-host.example
